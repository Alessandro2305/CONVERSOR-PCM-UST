{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "interface.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/escrever-no-pdf-original",
      "methods": ["POST", "OPTIONS"],
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/interface.html"
    }
  ]
}